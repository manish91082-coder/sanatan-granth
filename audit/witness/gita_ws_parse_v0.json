  "limits": [
    "यह text-lock नहीं है",
    "एक ही गवाह (संस्कृत विकिस्रोत): स्वतंत्र दूसरा गवाह और छपा सार्वजनिक-डोमेन संस्करण बाक़ी",
    "केवल वे अध्याय जिनके पन्ने जाँचे गए",
    "'उवाच' की पंक्तियाँ गवाह में जहाँ हैं वहीं ली गई हैं; गवाह में कुछ छूटी भी हो सकती हैं",
    "रिपोर्ट में पाठ नहीं, केवल गिनतियाँ और hash"
  ]
}
