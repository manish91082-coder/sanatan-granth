{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanatan-granth.invalid/schema/catalog_card.schema.json",
  "title": "सूची-कार्ड: catalog/<work_id>.json",
  "description": "13 समूह (सूची और निर्माण §1.5) + विषय/तिथि/copyright fields (मास्टर योजना §2)। कोई कार्ड बिना स्रोत (attested_by) के नहीं।",
  "type": "object",
  "required": ["work_id", "titles", "subject", "existence", "attested_by", "attestation_count", "confidence", "production_status", "last_checked"],
  "additionalProperties": false,
  "properties": {
    "work_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$", "description": "स्थिर slug, जैसे pur.maha.vishnu"},
    "ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wikidata_qid": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
        "wikidata_qid_checked_by_hand": {"type": "boolean"},
        "acc_ref": {"type": "string"},
        "ncc_ref": {"type": "string"},
        "pandit_id": {"type": "string"},
        "gretil_path": {"type": "string"},
        "dcs_text_id": {"type": "string"},
        "muktabodha_id": {"type": "string"},
        "viaf": {"type": "string"},
        "loc": {"type": "string"},
        "ddc": {"type": "string"}
      }
    },
    "titles": {
      "type": "object",
      "required": ["title_iast"],
      "additionalProperties": false,
      "properties": {
        "title_devanagari": {"type": "string"},
        "title_iast": {"type": "string"},
        "title_hi": {"type": "string"},
        "title_en": {"type": "string"},
        "alt_titles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "source"],
            "additionalProperties": false,
            "properties": {"title": {"type": "string"}, "script": {"type": "string"}, "source": {"type": "string"}}
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "required": ["l1", "l2", "placed_per_source"],
      "additionalProperties": false,
      "properties": {
        "l1": {"type": "string", "description": "catalog/_taxonomy.json का l1.id"},
        "l2": {"type": "string", "description": "catalog/_taxonomy.json का l2 id"},
        "placed_per_source": {"type": "string", "description": "'X के अंतर्गत, स्रोत Y के अनुसार'"},
        "category_path": {"type": "array", "items": {"type": "string"}},
        "text_type": {"type": "string"},
        "sampradaya": {"type": "array", "items": {"type": "string"}},
        "veda": {"type": "string"},
        "shakha": {"type": "string"},
        "language": {"type": "array", "items": {"type": "string"}},
        "kala_ids": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kala", "list_source"],
            "additionalProperties": false,
            "properties": {"kala": {"type": "string"}, "list_source": {"type": "string"}}
          }
        },
        "parent_work_id": {"type": "string"},
        "relation": {"enum": ["part_of", "recension_of", "commentary_on", "confused_with", "same_as", "translation_of"]},
        "sensitivity": {"enum": ["none", "adult", "restricted_tradition", "social_context_box", "prediction_claims", "health_claims", "shared_heritage", "living_person"]},
        "production_phase": {"type": "integer", "minimum": 1, "maximum": 5},
        "in_scope": {"type": "boolean"},
        "out_of_scope_reason": {"type": "string"},
        "multiple_heritage": {"type": "string"}
      }
    },
    "canon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canon_lists": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["list", "source"],
            "additionalProperties": false,
            "properties": {"list": {"type": "string"}, "rank": {"type": "integer"}, "source": {"type": "string"}}
          }
        },
        "canon_status": {"type": "string"}
      }
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date_traditional": {"type": "array", "items": {"$ref": "defs.schema.json#/$defs/date_traditional"}},
        "date_academic": {"type": "array", "items": {"$ref": "defs.schema.json#/$defs/date_academic"}},
        "terminus_post_quem": {"type": "object", "required": ["value", "reason"], "properties": {"value": {"type": "string"}, "reason": {"type": "string"}}},
        "terminus_ante_quem": {"type": "object", "required": ["value", "reason"], "properties": {"value": {"type": "string"}, "reason": {"type": "string"}}},
        "oldest_witness": {
          "type": "object",
          "required": ["type", "date", "ref"],
          "additionalProperties": false,
          "properties": {"type": {"enum": ["manuscript", "inscription", "print"]}, "date": {"type": "string"}, "collection": {"type": "string"}, "ref": {"type": "string"}}
        },
        "first_publication": {"type": "object", "required": ["year", "sources"], "properties": {"year": {"type": "integer"}, "sources": {"type": "array", "items": {"type": "string"}}}},
        "science_event_link": {"type": "array", "items": {"type": "object"}},
        "timeline_lane_display": {"type": "array", "items": {"enum": ["traditional", "academic", "scientific"]}},
        "date_status": {"enum": ["filled", "not_yet_researched", "no_source_found"], "description": "तिथि ख़ाली हो तो स्थिति अनिवार्य; कोई तिथि बिना स्रोत नहीं"}
      }
    },
    "authorship": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["person", "role", "attribution"],
        "additionalProperties": false,
        "properties": {
          "person": {"type": "string"},
          "person_id": {"type": "string"},
          "role": {"enum": ["drashta", "rachayita", "sankalak", "tikakar", "translator", "editor"]},
          "attribution": {"enum": ["traditional", "historical"]},
          "source": {"type": "string"}
        }
      }
    },
    "extent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extent_claimed": {"type": "string"},
        "extent_edition": {"type": "object", "properties": {"count": {"type": "integer"}, "unit": {"type": "string"}, "edition": {"type": "string"}}},
        "parts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "existence": {"enum": ["extant", "partially_extant", "lost", "disputed", "manuscript_only", "unknown"]},
    "manuscript_count": {"type": "object", "properties": {"count": {"type": "integer"}, "looked_up_on": {"type": "string", "format": "date"}, "source": {"type": "string"}}},
    "editions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edition_id", "licence_status"],
        "additionalProperties": false,
        "properties": {
          "edition_id": {"type": "string"},
          "edition": {"type": "string"},
          "year": {"type": "integer"},
          "editor": {"type": "string"},
          "editor_death_year": {"type": ["integer", "null"]},
          "publisher": {"type": "string"},
          "licence_status": {"enum": ["PD", "CC-BY", "CC0", "NC", "SA", "ND", "all-rights-reserved", "unknown"]},
          "pd_india": {"enum": ["yes", "no", "assume-copyright"]},
          "pd_us": {"enum": ["yes", "no", "assume-copyright"]},
          "pd_fact_sources": {"type": "array", "items": {"type": "string"}, "description": "copyright तय करने वाले हर तथ्य के ≥2 स्रोत; कम हों तो pd_* = assume-copyright"},
          "url": {"type": "string"}
        }
      }
    },
    "digital": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "availability": {"enum": ["open_machine_readable", "restricted", "scan_only", "none", "unknown"]},
        "best_source": {"type": "string"},
        "etext_flags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "attested_by": {"type": "array", "minItems": 1, "items": {"$ref": "defs.schema.json#/$defs/attestation"}},
    "attestation_count": {"type": "integer", "minimum": 1},
    "confidence": {"enum": ["high", "medium", "low"]},
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priority_score": {"type": "number"},
        "priority_inputs": {"type": "object"}
      }
    },
    "production_status": {"enum": ["CATALOGUED", "SELECTED", "SOURCES_APPROVED", "ACQUIRED", "NORMALISED", "WITNESS_DIFFED", "TEXT_LOCKED", "ANALYSED", "DRAFTED", "JUDGED", "REVISED", "SCIENCE_SCREENED", "MACHINE_COMPLETE", "RELEASED_INTERNAL", "LISTED_ONLY", "METADATA_ONLY"]},
    "listing_mode": {"enum": ["full_text", "india_only", "metadata_only", "listed_not_assessed"]},
    "last_checked": {"type": "string", "format": "date"},
    "notes": {"type": "string"}
  }
}
